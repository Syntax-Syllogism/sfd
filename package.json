{
  "name": "@syntax-syllogism/sfd",
  "version": "0.8.0",
  "description": "Warm Salesforce CLI daemon: SOQL, anonymous Apex, REST, describe, deploy, and Apex tests without sf startup cost.",
  "type": "module",
  "bin": {
    "sfd": "bin/sfd.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/sfd.mjs",
    "src",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "packages/sfd-plugin/package.json",
    "packages/sfd-plugin/index.mjs",
    "packages/sfd-plugin/index.d.ts",
    "packages/sfd-plugin/validate.d.ts",
    "packages/sfd-plugin/validate.mjs",
    "packages/sfd-plugin/cli.schema.json",
    "packages/sfd-plugin/testkit.d.ts",
    "packages/sfd-plugin/testkit.mjs",
    "packages/sfd-plugin/README.md",
    "packages/sfd-plugin/LICENSE"
  ],
  "keywords": [
    "salesforce",
    "sf",
    "sfdx",
    "cli",
    "daemon",
    "apex",
    "soql",
    "agents"
  ],
  "homepage": "https://github.com/Syntax-Syllogism/sfd#readme",
  "bugs": {
    "url": "https://github.com/Syntax-Syllogism/sfd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntax-Syllogism/sfd.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs packages/sfd-plugin/test/*.test.mjs",
    "test:soak": "node --expose-gc --test --test-name-pattern='cache sizes remain bounded' test/org-session.test.mjs",
    "typecheck": "tsc -p packages/sfd-plugin && tsc -p src/plugin && tsc -p src && tsc -p src/tsconfig.strict.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2"
  }
}
