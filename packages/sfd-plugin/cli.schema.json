{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sfd CLI table v0",
  "type": "object",
  "required": [
    "apiVersion",
    "commands"
  ],
  "properties": {
    "apiVersion": {
      "const": 0
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation",
          "name",
          "summary",
          "flags"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "name": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "sf": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "agentTip": {
            "type": "string"
          },
          "docs": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "char": {
                  "type": "string",
                  "pattern": "^[A-Za-z]$"
                },
                "type": {
                  "enum": [
                    "string",
                    "boolean",
                    "integer",
                    "file",
                    "directory"
                  ]
                },
                "multiple": {
                  "type": "boolean"
                },
                "required": {
                  "type": "boolean"
                },
                "option": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "formatter": {
            "oneOf": [
              {
                "enum": [
                  "table",
                  "csv",
                  "summary",
                  "json"
                ]
              },
              {
                "type": "object",
                "required": [
                  "module"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "pattern": "^\\./(?!.*(?:\\\\|\\u0000))(?!.*(?:^|/)\\.\\.(?:/|$)).+"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
